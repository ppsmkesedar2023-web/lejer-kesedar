<!DOCTYPE html>
<html lang="ms">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Kalkulator & Lejer Pinjaman</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Pustaka html2pdf.js untuk jana & muat turun PDF -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/html2pdf.js/0.10.1/html2pdf.bundle.min.js"></script>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Inter:wght=300;400;600;700&display=swap');
        body { font-family: 'Inter', sans-serif; }
        @media print {
            .no-print { display: none !important; }
            body { background: white !important; padding: 0 !important; }
            .print-container { border: none !important; shadow: none !important; }
        }
    </style>
</head>
<body class="bg-gray-100 p-4 md:p-8 flex flex-col min-h-screen">

    <div class="max-w-5xl mx-auto space-y-6 flex-grow w-full">
        
        <!-- Borang Input Pengiraan -->
        <div class="bg-white p-6 rounded-2xl shadow-sm border border-gray-200 no-print">
            <h1 class="text-2xl font-bold text-gray-800 mb-4">Pengiraan Lejer Pinjaman</h1>
            <form id="calc-form" onsubmit="janaLejer(event)" class="grid grid-cols-1 md:grid-cols-4 gap-4">
                <div>
                    <label class="block text-xs font-semibold text-gray-600 mb-1">Jumlah Pinjaman (RM)</label>
                    <input type="number" id="jumlahPinjaman" step="0.01" value="10000" required class="w-full p-2.5 border rounded-lg bg-gray-50 text-sm outline-none focus:ring-2 focus:ring-indigo-500">
                </div>
                <div>
                    <label class="block text-xs font-semibold text-gray-600 mb-1">Kadar Faedah Tahunan (%)</label>
                    <input type="number" id="kadarFaedah" step="0.01" value="5.0" required class="w-full p-2.5 border rounded-lg bg-gray-50 text-sm outline-none focus:ring-2 focus:ring-indigo-500">
                </div>
                <div>
                    <label class="block text-xs font-semibold text-gray-600 mb-1">Tempoh (Bulan)</label>
                    <input type="number" id="tempohBulan" value="12" required class="w-full p-2.5 border rounded-lg bg-gray-50 text-sm outline-none focus:ring-2 focus:ring-indigo-500">
                </div>
                <div>
                    <label class="block text-xs font-semibold text-gray-600 mb-1">Tarikh Mula</label>
                    <input type="date" id="tarikhMula" required class="w-full p-2.5 border rounded-lg bg-gray-50 text-sm outline-none focus:ring-2 focus:ring-indigo-500">
                </div>
                <div class="md:col-span-4 flex flex-wrap gap-2 pt-2">
                    <button type="submit" class="flex-1 bg-indigo-600 text-white font-bold py-2.5 rounded-lg hover:bg-indigo-700 transition text-sm">Jana Jadual Lejer</button>
                    <button type="button" id="btn-pdf" onclick="muatTurunPDF()" class="hidden bg-emerald-600 text-white font-bold px-6 py-2.5 rounded-lg hover:bg-emerald-700 transition text-sm flex items-center gap-1">Muat Turun PDF</button>
                    <button type="button" onclick="window.print()" class="bg-gray-800 text-white font-bold px-6 py-2.5 rounded-lg hover:bg-gray-900 transition text-sm">Cetak</button>
                </div>
            </form>
        </div>

        <!-- Ringkasan & Paparan Jadual Lejer -->
        <div id="keputusan" class="hidden bg-white p-6 md:p-8 rounded-2xl shadow-sm border border-gray-200 print-container">
            
            <div class="border-b pb-4 mb-6">
                <h2 class="text-xl font-bold text-gray-800">Jadual Amortisasi Lejer Pinjaman</h2>
                <p class="text-xs text-gray-500">Berdasarkan Kaedah Baki Berkurangan</p>
            </div>

            <!-- Kad Ringkasan -->
            <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-6 bg-indigo-50/50 p-4 rounded-xl text-sm">
                <div>
                    <p class="text-xs text-gray-500 font-semibold">Ansuran Bulanan</p>
                    <p id="summary-ansuran" class="text-lg font-bold text-indigo-600">RM 0.00</p>
                </div>
                <div>
                    <p class="text-xs text-gray-500 font-semibold">Jumlah Faedah</p>
                    <p id="summary-faedah" class="text-lg font-bold text-gray-800">RM 0.00</p>
                </div>
                <div>
                    <p class="text-xs text-gray-500 font-semibold">Jumlah Pelunasan</p>
                    <p id="summary-pelunasan" class="text-lg font-bold text-gray-800">RM 0.00</p>
                </div>
                <div>
                    <p class="text-xs text-gray-500 font-semibold">Tempoh Bayaran</p>
                    <p id="summary-tempoh" class="text-lg font-bold text-gray-800">0 Bulan</p>
                </div>
            </div>

            <!-- Jadual Lejer -->
            <div class="overflow-x-auto">
                <table class="w-full text-left text-xs border-collapse">
                    <thead>
                        <tr class="bg-gray-100 text-gray-700 uppercase">
                            <th class="p-3 border text-center">Bulan</th>
                            <th class="p-3 border">Tarikh Bayaran</th>
                            <th class="p-3 border text-right">Ansuran (RM)</th>
                            <th class="p-3 border text-right">Pokok (RM)</th>
                            <th class="p-3 border text-right">Faedah (RM)</th>
                            <th class="p-3 border text-right">Baki Akhir (RM)</th>
                        </tr>
                    </thead>
                    <tbody id="jadual-lejer-body" class="divide-y divide-gray-200 font-mono">
                        <!-- Baris lejer dimasukkan melalui JavaScript -->
                    </tbody>
                </table>
            </div>

            <!-- Hak Cipta Dalam Dokumen PDF/Cetak -->
            <div class="mt-8 text-center text-[10px] text-gray-400 border-t pt-4">
                Hak Cipta Terpelihara &copy; Zulfadzli
            </div>
        </div>

    </div>

    <!-- Hak Cipta Di Bawah Laman Web -->
    <footer class="mt-8 text-center text-[10px] text-gray-400 py-4 no-print">
        Hak Cipta Terpelihara &copy; Zulfadzli
    </footer>

    <script>
        // Set tarikh mula automatik ke hari ini
        document.getElementById('tarikhMula').valueAsDate = new Date();

        function janaLejer(e) {
            e.preventDefault();

            const P = parseFloat(document.getElementById('jumlahPinjaman').value);
            const kadarTahunan = parseFloat(document.getElementById('kadarFaedah').value);
            const N = parseInt(document.getElementById('tempohBulan').value);
            const tarikhMulaVal = document.getElementById('tarikhMula').value;

            if (P <= 0 || N <= 0) return;

            const r = (kadarTahunan / 100) / 12; // Kadar faedah bulanan
            let ansuran = 0;

            if (r === 0) {
                ansuran = P / N;
            } else {
                ansuran = (P * r * Math.pow(1 + r, N)) / (Math.pow(1 + r, N) - 1);
            }

            let baki = P;
            let jumlahFaedah = 0;
            let tbodyHtml = '';

            for (let i = 1; i <= N; i++) {
                const faedahBulanIni = baki * r;
                let pokokBulanIni = ansuran - faedahBulanIni;

                if (i === N) {
                    pokokBulanIni = baki;
                    baki = 0;
                } else {
                    baki -= pokokBulanIni;
                }

                jumlahFaedah += faedahBulanIni;

                const tarikhBayaran = new Date(tarikhMulaVal);
                tarikhBayaran.setMonth(tarikhBayaran.getMonth() + i - 1);

                tbodyHtml += `
                    <tr class="hover:bg-gray-50">
                        <td class="p-2.5 border text-center font-bold font-sans">${i}</td>
                        <td class="p-2.5 border font-sans">${tarikhBayaran.toISOString().split('T')[0]}</td>
                        <td class="p-2.5 border text-right font-bold text-indigo-600">${ansuran.toFixed(2)}</td>
                        <td class="p-2.5 border text-right">${pokokBulanIni.toFixed(2)}</td>
                        <td class="p-2.5 border text-right text-amber-600">${faedahBulanIni.toFixed(2)}</td>
                        <td class="p-2.5 border text-right font-bold">${Math.max(0, baki).toFixed(2)}</td>
                    </tr>
                `;
            }

            // Kemaskini Kad Ringkasan
            document.getElementById('summary-ansuran').innerText = `RM ${ansuran.toFixed(2)}`;
            document.getElementById('summary-faedah').innerText = `RM ${jumlahFaedah.toFixed(2)}`;
            document.getElementById('summary-pelunasan').innerText = `RM ${(P + jumlahFaedah).toFixed(2)}`;
            document.getElementById('summary-tempoh').innerText = `${N} Bulan`;

            // Masukkan data ke jadual & paparkan butang PDF
            document.getElementById('jadual-lejer-body').innerHTML = tbodyHtml;
            document.getElementById('keputusan').classList.remove('hidden');
            document.getElementById('btn-pdf').classList.remove('hidden');
        }

        function muatTurunPDF() {
            const elemen = document.getElementById('keputusan');
            const tarikhHarini = new Date().toISOString().split('T')[0];

            const tetapan = {
                margin:       [10, 10, 10, 10],
                filename:     `lejer_pinjaman_${tarikhHarini}.pdf`,
                image:        { type: 'jpeg', quality: 0.98 },
                html2canvas:  { scale: 2 },
                jsPDF:        { unit: 'mm', format: 'a4', orientation: 'portrait' }
            };

            html2pdf().set(tetapan).from(elemen).save();
        }
    </script>
</body>
</html>
